{
	"$schema": "https://schema.tauri.app/config/2.0.0-rc",
	"build": {
		"beforeDevCommand": "pnpm dev --host",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/64x64.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/icon.png"
		],
		"createUpdaterArtifacts": true,
		"android": {
			"minSdkVersion": 26
		}
	},
	"productName": "AMLL Player",
	"version": "0.0.1",
	"identifier": "net.stevexmh.amllplayer",
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzMDQ4M0YwOEEyNjFDQjAKUldTd0hDYUs4SU1FWTdkdFRVb0RzTk9rVVBPWkJBZzBPMVJ2cDNIM3oxU1huU1Y2cENqVDBXNmkK"
		}
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [],
		"security": {
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": ["$APPDATA/**/*"],
					"deny": []
				}
			}
		}
	}
}
